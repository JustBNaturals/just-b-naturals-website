{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "just-b-naturals-website",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-07",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "DELIVERY_RATE_PER_KM_CENTS": "100"
  },
  "d1_databases": [
    {
      "binding": "INVENTORY_DB",
      "database_name": "just-b-naturals-inventory",
      "database_id": "f15f5219-1ec9-417d-91ff-0dce5735ae24"
    }
  ]
}

